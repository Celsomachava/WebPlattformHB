{
  "testEnvironment": "jsdom",
  "setupFilesAfterEnv": ["<rootDir>/src/tests/setup.js"],
  "moduleNameMapper": {
    "\\.(css|less|scss|sass)$": "identity-obj-proxy"
  },
  "testMatch": [
    "<rootDir>/src/tests/**/*.test.js",
    "<rootDir>/src/tests/**/*.test.jsx"
  ],
  "collectCoverageFrom": [
    "src/**/*.{js,jsx}",
    "!src/main.jsx",
    "!src/tests/**",
    "!src/**/*.ts",
    "!src/**/*.tsx",
    "!src/utils/apiTransform.js",
    "!src/components/ui/OptimizedImage.jsx"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 70,
      "lines": 70,
      "statements": 70
    }
  },
  "transform": {
    "^.+\\.(js|jsx)$": "babel-jest"
  },
  "extensionsToTreatAsEsm": [".jsx"],
  "globals": {
    "__DEV__": true
  }
}