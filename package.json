{
  "name": "heduschka-service-pwa",
  "version": "1.0.0",
  "description": "PWA for Heduschka GmbH digital filter service requests",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently \"cd Backend && npm run dev\" \"npm run dev\"",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start:full": "concurrently \"cd Backend && npm run dev\" \"npm run dev\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "cypress open",
    "test:e2e:headless": "cypress run",
    "lighthouse": "lighthouse http://localhost:4173 --output=html --output-path=./lighthouse-report.html --chrome-flags=\"--headless\"",
    "audit": "npm run build && npm run preview & sleep 3 && npm run lighthouse && kill %1",
    "deploy:build": "npm run build"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.2",
    "crypto-js": "^4.1.1",
    "dexie": "^3.2.4",
    "idb": "^7.1.1",
    "jspdf": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.70.0",
    "react-router-dom": "^6.8.0",
    "workbox-window": "^6.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^0.16.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
